{
    "name": "phattarachai/watchtower-laravel",
    "description": "Sentry-compatible error tracking inside your Laravel app: its own tables, issue UI, alerts and an MCP server for Claude, on top of sentry/sentry-laravel. Can also relay to a central Watchtower server.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sentry",
        "watchtower",
        "error-tracking",
        "exception-tracking",
        "observability"
    ],
    "authors": [
        {
            "name": "Phattarachai Chaimongkol",
            "email": "pc@phattarachai.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "phattarachai/watchtower-core": "^1.3",
        "sentry/sentry-laravel": "^4.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phattarachai/watchtower-core"
        }
    ],
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "larastan/larastan": "^3.10",
        "laravel/mcp": "^0.7 || ^1.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Serves the standalone issue UI at /{prefix}. Needs an Inertia + React host with Tailwind v4 (^2.0|^3.0).",
        "laravel/mcp": "Serves the embedded Watchtower MCP server at /{prefix}/mcp so Claude can triage issues in place (^0.7)."
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\WatchtowerLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\WatchtowerLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:php",
            "@test:js"
        ],
        "test:php": "vendor/bin/pest",
        "test:js": "node --test tests/js/*.test.mjs",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phattarachai\\WatchtowerLaravel\\WatchtowerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "cooldown": {
                "period": "1 day",
                "ignore": {
                    "phattarachai/*": "Our own packages, released by us"
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
