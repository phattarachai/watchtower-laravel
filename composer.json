{
    "name": "phattarachai/watchtower-laravel",
    "description": "Laravel client for the Watchtower self-hosted Sentry-compatible exception tracker. Wires up sentry/sentry-laravel and a same-origin browser tunnel that dodges ad blockers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sentry",
        "watchtower",
        "error-tracking",
        "exception-tracking",
        "observability"
    ],
    "authors": [
        {
            "name": "Phattarachai Chaimongkol",
            "email": "pc@phattarachai.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "phattarachai/watchtower-core": "@dev",
        "sentry/sentry-laravel": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../watchtower-core",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/mcp": "^0.7",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "laravel/mcp": "Serves the embedded Watchtower MCP server at /{prefix}/mcp so Claude can triage issues in place (^0.7)."
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\WatchtowerLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\WatchtowerLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:php",
            "@test:js"
        ],
        "test:php": "vendor/bin/pest",
        "test:js": "node --test tests/js/*.test.mjs",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phattarachai\\WatchtowerLaravel\\WatchtowerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
